    {id:"gon_paper", name:"Джаджанкен (Бумага)", icon:"✦", cost:22, cooldown:2, power:20, desc:"Дальний выброс ауры, игнорирует 25% Защиты цели.", type:"pierce", tags:["ДАЛЬНИЙ"]},
    {id:"gon_scissors", name:"Джаджанкен (Ножницы)", icon:"✂", cost:24, cooldown:2, power:18, desc:"Точная режущая атака с шансом критического удара.", type:"crit", tags:["КРИТ"]},
